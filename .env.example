# Copy to .env and fill in. Never commit .env.

# fal.ai -> Dashboard -> Keys (API scope). Image generation:
# FLUX Fill inpainting (Design Autocomplete), IC-Light v2 (Relight "Enhance").
FAL_KEY=

# replicate.com -> Account -> API tokens. Zero123++ novel views (Turnaround).
REPLICATE_API_TOKEN=

# console.anthropic.com -> API keys. Vision LLM: planner, character spec, feature checklist.
ANTHROPIC_API_KEY=

# aistudio.google.com -> Get API key. Alternative vision LLM, and prompt-based image edit fallback.
GEMINI_API_KEY=

# huggingface.co -> Settings -> Access Tokens (read). Optional: only for gated models or rate limits.
HF_TOKEN=

# Set to 1 to make the backend return canned responses without calling any paid API.
MOCK_MODE=1
