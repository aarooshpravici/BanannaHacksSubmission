# Copy to .env and fill in. Never commit .env.
# Only the "Enhance" button needs a key. Everything else runs with none.

# aistudio.google.com -> Get API key. Enhance through Gemini's image model.
GEMINI_API_KEY=

# fal.ai -> Dashboard -> Keys (API scope). Enhance through IC-Light v2, used when there is no Gemini key.
FAL_KEY=

# huggingface.co -> Settings -> Access Tokens (read). Optional: only if model downloads are rate limited.
HF_TOKEN=

# Which service Enhance uses: gemini, fal, or auto (Gemini if it has a key, else fal).
IMAGE_PROVIDER=auto

# Hard cap on paid Gemini image generations (counted in .cache/spend.json).
GEMINI_IMAGE_CALL_LIMIT=10

# Set to 1 to make Enhance return the preview unchanged without calling any paid API.
MOCK_MODE=1
