# Copy to .env.local and edit. Restart `npm run dev` after changing.

# 1 = no backend needed: lib/api.ts returns canned responses built in the browser.
# 0 = call the real FastAPI backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_MOCK=1

# Where the FastAPI backend lives (only used when NEXT_PUBLIC_MOCK=0).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only for hosting under a sub-folder, e.g. /relight for https://example.com/relight/. Leave unset otherwise.
# NEXT_PUBLIC_BASE_PATH=

# Do not set NEXT_PUBLIC_DEMO here: `npm run build:demo` sets it, to build the static demo (see README.md).
